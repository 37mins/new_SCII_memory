# Integrated fixes v1; historical Canonical behavior remains in frozen commits.
SC2_DIFFICULTY=${SC2_DIFFICULTY:-Hard}
SC2_AI_BUILD=${SC2_AI_BUILD:-Air}
SC2_ENV_SEED=${SC2_ENV_SEED:-0}
# The original SC2_online.zip has no Planner-call termination limit.
# Set a positive value only for an explicit truncation test.
SC2_MAX_STEPS=${SC2_MAX_STEPS:-0}
SC2_STEP_SHAPING_MODE=${SC2_STEP_SHAPING_MODE:-off}
SC2_ROLLOUT_N=${SC2_ROLLOUT_N:-8}
SC2_PLAN_SEGMENT_MAX=${SC2_PLAN_SEGMENT_MAX:-6}
SC2_PLAN_BULLET_MAX=${SC2_PLAN_BULLET_MAX:-6}
MAX_PROMPT_LENGTH=${MAX_PROMPT_LENGTH:-4096}
MAX_RESPONSE_LENGTH=${MAX_RESPONSE_LENGTH:-96}
TOTAL_EPOCHS=${TOTAL_EPOCHS:-96}
SAVE_FREQ=${SAVE_FREQ:-${TOTAL_EPOCHS}}
BO_PROFILE=${BO_PROFILE:-canonical}
