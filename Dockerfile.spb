# Build the normal Dockerfile first: docker build -t sc2-system-v1 .
FROM sc2-system-v1

ARG SPB_COMMIT=02561132682c2a66925bb0df9f6a1d3f9e816723
RUN git clone https://github.com/BICLab/SpikingBrain2.0.git /opt/SpikingBrain2.0 \
    && git -C /opt/SpikingBrain2.0 checkout --detach "${SPB_COMMIT}" \
    && test "$(git -C /opt/SpikingBrain2.0 rev-parse HEAD)" = "${SPB_COMMIT}"
RUN TORCH_CUDA_ARCH_LIST=8.0 MAX_JOBS=8 python -m pip install --no-build-isolation flash-attn==2.6.3
RUN python -m pip install --no-deps \
    /opt/SpikingBrain2.0/flash-linear-attention_dev /opt/SpikingBrain2.0/MoBA
